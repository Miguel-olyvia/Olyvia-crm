# Do NOT commit a real .env to source control.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# GEMINI_API_KEY is a server-side Supabase secret (not a client-side VITE_ var), so it does NOT
# belong in this file. Set it via: supabase secrets set GEMINI_API_KEY="your-key-here"

# Sentry (error tracking). DSN is safe to expose client-side by design.
VITE_SENTRY_DSN=
# Build-time only, never prefixed VITE_ — used to upload sourcemaps during `vite build`.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog (product analytics). Project API key is safe to expose client-side.
# Use the EU Cloud host for GDPR data residency -- app.posthog.com is US.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
