# Lovable Cloud auto-fills these variables. Do NOT commit a real .env to source control.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Sentry (error tracking). DSN is safe to expose client-side by design.
VITE_SENTRY_DSN=
# Build-time only, never prefixed VITE_ — used to upload sourcemaps during `vite build`.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
