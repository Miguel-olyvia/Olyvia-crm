{
  "proposal.html.basico": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Casa de banho completa</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #f5f5f5;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f5f5f5; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n          <!-- Header -->\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #3b82f6, #1e40af); padding: 40px; text-align: center;\">\n              \n              <h1 style=\"color: #ffffff; margin: 0; font-size: 24px;\">Casa de banho completa</h1>\n            </td>\n          </tr>\n          \n          <!-- Content -->\n          <tr>\n            <td style=\"padding: 40px;\">\n              \n                <p style=\"color: #374151; font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n                  Foi-lhe enviada uma proposta para análise.\n                </p>\n              \n              \n              \n              \n              <!-- Value Box -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f9fafb; border-radius: 8px; margin-bottom: 24px;\">\n                <tr>\n                  <td style=\"padding: 20px; text-align: center;\">\n                    <p style=\"color: #6b7280; margin: 0 0 8px 0; font-size: 14px;\">Valor da Proposta</p>\n                    <p style=\"color: #3b82f6; margin: 0; font-size: 32px; font-weight: bold;\">\n                      12 345,60 €\n                    </p>\n                  </td>\n                </tr>\n              </table>\n              \n              \n              \n              <!-- CTA Button -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"https://app.test/client-portal/proposals/p1\" style=\"display: inline-block; background-color: #3b82f6; color: #ffffff; text-decoration: none; padding: 16px 40px; border-radius: 8px; font-weight: 600; font-size: 16px;\">\n                      Ver Proposta Completa\n                    </a>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          \n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color: #f9fafb; padding: 24px; text-align: center; border-top: 1px solid #e5e7eb;\">\n              <p style=\"color: #9ca3af; font-size: 12px; margin: 0;\">\n                Enviado automaticamente\n              </p>\n              \n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n  ",
  "proposal.subject.basico": "Proposta: Casa de banho completa",
  "proposal.html.completo": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Remodelacao da cozinha</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #f5f5f5;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f5f5f5; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n          <!-- Header -->\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #123ABC, #1e40af); padding: 40px; text-align: center;\">\n              <img src=\"https://cdn.test/logo.png\" alt=\"Logo\" style=\"max-height: 60px; margin-bottom: 20px;\">\n              <h1 style=\"color: #ffffff; margin: 0; font-size: 24px;\">Remodelacao da cozinha</h1>\n            </td>\n          </tr>\n          \n          <!-- Content -->\n          <tr>\n            <td style=\"padding: 40px;\">\n              \n                <p style=\"color: #374151; font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n                  Ola Rita,\nsegue a proposta &lt;b&gt;combinada&lt;/b&gt;.\n                </p>\n              \n              \n              \n                <p style=\"color: #6b7280; font-size: 14px; line-height: 1.6; margin-bottom: 24px;\">\n                  Descricao da proposta para o cliente ver. Inclui demolicao, canalizacao, eletricidade, azulejos, bancada, moveis, eletrodomesticos e pintura final de todas as paredes e tetos da divisao, com garantia ...\n                </p>\n              \n              \n              <!-- Value Box -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f9fafb; border-radius: 8px; margin-bottom: 24px;\">\n                <tr>\n                  <td style=\"padding: 20px; text-align: center;\">\n                    <p style=\"color: #6b7280; margin: 0 0 8px 0; font-size: 14px;\">Valor da Proposta</p>\n                    <p style=\"color: #123ABC; margin: 0; font-size: 32px; font-weight: bold;\">\n                      1999,50 US$\n                    </p>\n                  </td>\n                </tr>\n              </table>\n              \n              \n                <p style=\"color: #6b7280; font-size: 14px; text-align: center; margin-bottom: 24px;\">\n                  Válida até: <strong>31/12/2026</strong>\n                </p>\n              \n              \n              <!-- CTA Button -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"https://app.test/client-portal/proposals/p2\" style=\"display: inline-block; background-color: #123ABC; color: #ffffff; text-decoration: none; padding: 16px 40px; border-radius: 8px; font-weight: 600; font-size: 16px;\">\n                      Ver Proposta Completa\n                    </a>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          \n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color: #f9fafb; padding: 24px; text-align: center; border-top: 1px solid #e5e7eb;\">\n              <p style=\"color: #9ca3af; font-size: 12px; margin: 0;\">\n                Enviado automaticamente\n              </p>\n              \n                <p style=\"color: #9ca3af; font-size: 12px; margin: 8px 0 0 0;\">\n                  Acme Lda - NIF 500000000\n                </p>\n              \n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n  ",
  "proposal.subject.completo": "Proposta personalizada",
  "proposal.html.semSnapshotComJoin": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pintura</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #f5f5f5;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f5f5f5; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n          <!-- Header -->\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #ff0000, #1e40af); padding: 40px; text-align: center;\">\n              <img src=\"https://cdn.test/l2.png\" alt=\"Logo\" style=\"max-height: 60px; margin-bottom: 20px;\">\n              <h1 style=\"color: #ffffff; margin: 0; font-size: 24px;\">Pintura</h1>\n            </td>\n          </tr>\n          \n          <!-- Content -->\n          <tr>\n            <td style=\"padding: 40px;\">\n              \n                <p style=\"color: #374151; font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n                  Joao enviou-lhe uma proposta para análise.\n                </p>\n              \n              \n              \n                <p style=\"color: #6b7280; font-size: 14px; line-height: 1.6; margin-bottom: 24px;\">\n                  Curta.\n                </p>\n              \n              \n              <!-- Value Box -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f9fafb; border-radius: 8px; margin-bottom: 24px;\">\n                <tr>\n                  <td style=\"padding: 20px; text-align: center;\">\n                    <p style=\"color: #6b7280; margin: 0 0 8px 0; font-size: 14px;\">Valor da Proposta</p>\n                    <p style=\"color: #ff0000; margin: 0; font-size: 32px; font-weight: bold;\">\n                      800,00 €\n                    </p>\n                  </td>\n                </tr>\n              </table>\n              \n              \n                <p style=\"color: #6b7280; font-size: 14px; text-align: center; margin-bottom: 24px;\">\n                  Válida até: <strong>02/01/2027</strong>\n                </p>\n              \n              \n              <!-- CTA Button -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"https://app.test/client-portal/proposals/p3\" style=\"display: inline-block; background-color: #ff0000; color: #ffffff; text-decoration: none; padding: 16px 40px; border-radius: 8px; font-weight: 600; font-size: 16px;\">\n                      Ver Proposta Completa\n                    </a>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          \n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color: #f9fafb; padding: 24px; text-align: center; border-top: 1px solid #e5e7eb;\">\n              <p style=\"color: #9ca3af; font-size: 12px; margin: 0;\">\n                Enviado automaticamente\n              </p>\n              \n                <p style=\"color: #9ca3af; font-size: 12px; margin: 8px 0 0 0;\">\n                  rodape vivo\n                </p>\n              \n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n  ",
