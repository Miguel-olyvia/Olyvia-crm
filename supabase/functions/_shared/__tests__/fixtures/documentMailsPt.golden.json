  "verification.html.omissaoAceitar": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Código de Verificação</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #f5f5f5;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f5f5f5; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"500\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #10b981, #059669); padding: 30px; text-align: center;\">\n              <h1 style=\"color: #ffffff; margin: 0; font-size: 20px;\">Código de Verificação</h1>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 40px; text-align: center;\">\n              <p style=\"color: #374151; font-size: 16px; margin-bottom: 16px;\">\n                Olá <strong>Cliente</strong>, para aceitar a proposta \"<strong>Casa de banho completa</strong>\", introduza o seguinte código:\n              </p>\n              \n              <div style=\"background-color: #f3f4f6; border-radius: 12px; padding: 24px; margin: 24px 0;\">\n                <p style=\"font-size: 36px; font-weight: bold; letter-spacing: 8px; color: #111827; margin: 0;\">\n                  123456\n                </p>\n              </div>\n              \n              <p style=\"color: #6b7280; font-size: 14px; margin-top: 24px;\">\n                Este código expira em 15 minutos.\n              </p>\n              <p style=\"color: #9ca3af; font-size: 12px; margin-top: 16px;\">\n                Se não solicitou este código, pode ignorar este email.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n  ",
  "verification.subject.omissaoAceitar": "Código de Verificação - Aceitar Proposta",
  "verification.html.omissaoRecusar": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Código de Verificação</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #f5f5f5;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f5f5f5; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"500\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #10b981, #059669); padding: 30px; text-align: center;\">\n              <h1 style=\"color: #ffffff; margin: 0; font-size: 20px;\">Código de Verificação</h1>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 40px; text-align: center;\">\n              <p style=\"color: #374151; font-size: 16px; margin-bottom: 16px;\">\n                Olá <strong>Cliente</strong>, para recusar a proposta \"<strong>Remodelacao da cozinha</strong>\", introduza o seguinte código:\n              </p>\n              \n              <div style=\"background-color: #f3f4f6; border-radius: 12px; padding: 24px; margin: 24px 0;\">\n                <p style=\"font-size: 36px; font-weight: bold; letter-spacing: 8px; color: #111827; margin: 0;\">\n                  654321\n                </p>\n              </div>\n              \n              <p style=\"color: #6b7280; font-size: 14px; margin-top: 24px;\">\n                Este código expira em 15 minutos.\n              </p>\n              <p style=\"color: #9ca3af; font-size: 12px; margin-top: 16px;\">\n                Se não solicitou este código, pode ignorar este email.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n  ",
  "verification.subject.omissaoRecusar": "Código de Verificação - Recusar Proposta",
  "verification.html.modeloAceitar": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Código de Verificação</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #f5f5f5;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f5f5f5; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"500\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n          <tr>\n            <td style=\"padding: 40px;\">\n              <p>Codigo 111222 para aceitar Pintura (Cliente). Outra vez 111222.</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n    ",
  "verification.subject.modeloAceitar": "Codigo para Pintura",
  "verification.html.modeloRecusar": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Código de Verificação</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #f5f5f5;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f5f5f5; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"500\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n          <tr>\n            <td style=\"padding: 40px;\">\n              <p>recusar</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n    ",
  "verification.subject.modeloRecusar": "Código de Verificação - Recusar Proposta",
  "portal.subject.credenciaisProposta": "Acesso ao Portal — Acme &amp; Filhos",
  "portal.html.credenciaisProposta": "\n        <div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n          <h2 style=\"color: #333;\">Ol&aacute;, Rita &lt;Sousa&gt;!</h2>\n          <p>Foi-lhe criado um acesso ao portal de <strong>Acme &amp; Filhos</strong>.</p>\n          <p>Tem uma <strong>proposta</strong> dispon&iacute;vel para consulta: <em>Casa &quot;de&quot; banho</em></p>\n\n          <div style=\"background: #f5f5f5; border-radius: 8px; padding: 16px; margin: 20px 0;\">\n            <p style=\"margin: 0 0 8px;\"><strong>Aceda ao portal:</strong></p>\n            <p style=\"margin: 0 0 4px;\"><a href=\"https://app.test/auth\" style=\"color: #2563eb;\">https://app.test/auth</a></p>\n            <p style=\"margin: 0 0 4px;\"><strong>Email:</strong> rita@x.pt</p>\n            <p style=\"margin: 0;\"><strong>Password tempor&aacute;ria:</strong> Tmp-Pass_123</p>\n          </div>\n\n          <p style=\"color: #666; font-size: 14px;\">Recomendamos que altere a password no primeiro acesso.</p>\n\n          <hr style=\"border: none; border-top: 1px solid #eee; margin: 20px 0;\">\n          <p style=\"color: #999; font-size: 13px;\">Enviado por Ana Silva &mdash; Acme &amp; Filhos</p>\n        </div>\n      ",
  "portal.subject.credenciaisContrato": "Acesso ao Portal — Acme",
  "portal.html.credenciaisContrato": "\n        <div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n          <h2 style=\"color: #333;\">Ol&aacute;, Rita!</h2>\n          <p>Foi-lhe criado um acesso ao portal de <strong>Acme</strong>.</p>\n          <p>Tem uma <strong>contrato</strong> dispon&iacute;vel para consulta: <em>CT-2026-001</em></p>\n\n          <div style=\"background: #f5f5f5; border-radius: 8px; padding: 16px; margin: 20px 0;\">\n            <p style=\"margin: 0 0 8px;\"><strong>Aceda ao portal:</strong></p>\n            <p style=\"margin: 0 0 4px;\"><a href=\"https://app.test/auth\" style=\"color: #2563eb;\">https://app.test/auth</a></p>\n            <p style=\"margin: 0 0 4px;\"><strong>Email:</strong> rita@x.pt</p>\n            <p style=\"margin: 0;\"><strong>Password tempor&aacute;ria:</strong> Zz9</p>\n          </div>\n\n          <p style=\"color: #666; font-size: 14px;\">Recomendamos que altere a password no primeiro acesso.</p>\n\n          <hr style=\"border: none; border-top: 1px solid #eee; margin: 20px 0;\">\n          <p style=\"color: #999; font-size: 13px;\">Enviado por Ana &mdash; Acme</p>\n        </div>\n      ",
  "portal.subject.novoDocProposta": "Nova proposta dispon&iacute;vel — Acme",
  "portal.html.novoDocProposta": "\n        <div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n          <h2 style=\"color: #333;\">Ol&aacute;, Rita!</h2>\n          <p>Tem uma nova <strong>proposta</strong> dispon&iacute;vel no seu portal: <em>Pintura</em></p>\n          <p>Aceda em: <a href=\"https://app.test/auth\" style=\"color: #2563eb;\">https://app.test/auth</a></p>\n          \n\n          <hr style=\"border: none; border-top: 1px solid #eee; margin: 20px 0;\">\n          <p style=\"color: #999; font-size: 13px;\">Enviado por Ana &mdash; Acme</p>\n        </div>\n      ",
  "portal.subject.novoDocContratoLigada": "Nova contrato dispon&iacute;vel — Acme",
  "portal.html.novoDocContratoLigada": "\n        <div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n          <h2 style=\"color: #333;\">Ol&aacute;, Rita!</h2>\n          <p>Tem uma nova <strong>contrato</strong> dispon&iacute;vel no seu portal: <em>CT-2026-002</em></p>\n          <p>Aceda em: <a href=\"https://app.test/auth\" style=\"color: #2563eb;\">https://app.test/auth</a></p>\n          <p>Entre com o email e a password que j&aacute; usa no portal. Depois de entrar, escolha <strong>Acme</strong> no seletor de empresa.</p>\n\n          <hr style=\"border: none; border-top: 1px solid #eee; margin: 20px 0;\">\n          <p style=\"color: #999; font-size: 13px;\">Enviado por Ana &mdash; Acme</p>\n        </div>\n      ",
