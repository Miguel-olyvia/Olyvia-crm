  "reminder.client.html": "\n  <div style=\"font-family:Inter,system-ui,sans-serif;background:#F4F6F5;padding:32px 16px\">\n    <div style=\"max-width:480px;margin:0 auto\">\n      <img src=\"https://cdn.test/logo.png\" alt=\"\" width=\"44\" height=\"44\" style=\"width:44px;height:44px;border-radius:12px;object-fit:cover;display:block;margin:0 0 20px\">\n      <div style=\"background:#ffffff;border-radius:16px;padding:32px;border:1px solid #E5E9E7\">\n        <h1 style=\"margin:0 0 8px;font-size:20px;font-weight:700;color:#111827\">Lembrete da sua visita</h1>\n        <p style=\"margin:0 0 20px;color:#4b5563;font-size:14px;line-height:1.5\">Este é um lembrete da sua visita agendada.</p>\n        <table role=\"presentation\" style=\"width:100%;border-collapse:collapse\">\n      <tr>\n        <td style=\"padding:10px 0;border-top:1px solid #EEF2F0;color:#6b7280;font-size:13px;white-space:nowrap;vertical-align:top\">Data / hora</td>\n        <td style=\"padding:10px 0 10px 16px;border-top:1px solid #EEF2F0;color:#111827;font-size:14px;font-weight:600;text-align:right\">segunda-feira, 5 de outubro de 2026 às 11:00</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 0;border-top:1px solid #EEF2F0;color:#6b7280;font-size:13px;white-space:nowrap;vertical-align:top\">Local</td>\n        <td style=\"padding:10px 0 10px 16px;border-top:1px solid #EEF2F0;color:#111827;font-size:14px;font-weight:600;text-align:right\">Rua A, Lisboa</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 0;border-top:1px solid #EEF2F0;color:#6b7280;font-size:13px;white-space:nowrap;vertical-align:top\">Técnico</td>\n        <td style=\"padding:10px 0 10px 16px;border-top:1px solid #EEF2F0;color:#111827;font-size:14px;font-weight:600;text-align:right\">Ana</td>\n      </tr></table>\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px auto 0\"><tr><td style=\"border-radius:10px;background:#059669\">\n        <a href=\"https://app.test/booking/confirm?token=xyz\" style=\"display:inline-block;padding:13px 32px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;font-family:Inter,system-ui,sans-serif\">Confirmo a visita</a>\n      </td></tr></table>\n        \n        <p style=\"margin:14px 0 0;text-align:center\"><a href=\"https://app.test/m?token=abc\" style=\"color:#6b7280;font-size:13px;text-decoration:underline\">Gerir ou cancelar agendamento</a></p>\n      </div>\n    </div>\n  </div>",
  "reminder.technician.subject": "Lembrete: visita a Rita Sousa — segunda-feira, 5 de outubro de 2026 às 11:00",
  "reminder.technician.html": "\n  <div style=\"font-family:Inter,system-ui,sans-serif;background:#F4F6F5;padding:32px 16px\">\n    <div style=\"max-width:480px;margin:0 auto\">\n      <div style=\"width:44px;height:44px;border-radius:12px;background:#85D3BE;margin:0 0 20px\"></div>\n      <div style=\"background:#ffffff;border-radius:16px;padding:32px;border:1px solid #E5E9E7\">\n        <h1 style=\"margin:0 0 8px;font-size:20px;font-weight:700;color:#111827\">Lembrete de visita</h1>\n        <p style=\"margin:0 0 20px;color:#4b5563;font-size:14px;line-height:1.5\">Lembrete: tem uma visita agendada com a lead abaixo.</p>\n        <table role=\"presentation\" style=\"width:100%;border-collapse:collapse\">\n      <tr>\n        <td style=\"padding:10px 0;border-top:1px solid #EEF2F0;color:#6b7280;font-size:13px;white-space:nowrap;vertical-align:top\">Lead</td>\n        <td style=\"padding:10px 0 10px 16px;border-top:1px solid #EEF2F0;color:#111827;font-size:14px;font-weight:600;text-align:right\">Rita Sousa</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 0;border-top:1px solid #EEF2F0;color:#6b7280;font-size:13px;white-space:nowrap;vertical-align:top\">Telefone</td>\n        <td style=\"padding:10px 0 10px 16px;border-top:1px solid #EEF2F0;color:#111827;font-size:14px;font-weight:600;text-align:right\">912345678</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 0;border-top:1px solid #EEF2F0;color:#6b7280;font-size:13px;white-space:nowrap;vertical-align:top\">Email</td>\n        <td style=\"padding:10px 0 10px 16px;border-top:1px solid #EEF2F0;color:#111827;font-size:14px;font-weight:600;text-align:right\">rita@x.pt</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 0;border-top:1px solid #EEF2F0;color:#6b7280;font-size:13px;white-space:nowrap;vertical-align:top\">Data / hora</td>\n        <td style=\"padding:10px 0 10px 16px;border-top:1px solid #EEF2F0;color:#111827;font-size:14px;font-weight:600;text-align:right\">segunda-feira, 5 de outubro de 2026 às 11:00</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 0;border-top:1px solid #EEF2F0;color:#6b7280;font-size:13px;white-space:nowrap;vertical-align:top\">Morada</td>\n        <td style=\"padding:10px 0 10px 16px;border-top:1px solid #EEF2F0;color:#111827;font-size:14px;font-weight:600;text-align:right\">Rua A, Lisboa</td>\n      </tr></table>\n        \n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px auto 0\"><tr><td style=\"border-radius:10px;background:#111827\">\n        <a href=\"https://app.test/scheduling\" style=\"display:inline-block;padding:13px 32px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;font-family:Inter,system-ui,sans-serif\">Abrir na agenda</a>\n      </td></tr></table>\n        \n      </div>\n    </div>\n  </div>",
