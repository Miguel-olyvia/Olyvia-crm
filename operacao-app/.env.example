# ─── Aplicação ────────────────────────────────────────────────────────
# Mesmo projeto Supabase da Olyvia. Só chaves públicas.
# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Link de regresso à plataforma, no menu do utilizador.
VITE_OLYVIA_URL=https://olyvia-ai.com


# ─── Só para os scripts de instalação ─────────────────────────────────
# Usada por `npm run supabase:*` para aplicar SQL. NUNCA vai para o browser
# (não tem prefixo VITE_) e NUNCA deve ser commitada — contém a password
# da base de dados.
#
# Supabase → Project Settings → Database → Connection string → URI
# Se a rede bloquear IPv6, usa a do "Session pooler".
DATABASE_URL=
